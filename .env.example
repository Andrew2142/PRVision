# PRVision local configuration (00 §4). `npm run setup:env` copies this to .env and fills generated values.
# .env is git-ignored. Never commit real secrets.

NODE_ENV=development

# Docker Compose services (docker-compose.yml): Postgres 16 on 5433, Redis 7 on 6380.
DATABASE_URL=postgres://prvision:prvision@127.0.0.1:5433/prvision
REDIS_URL=redis://127.0.0.1:6380

# Encrypts the GitHub token and Anthropic API key at rest. Generated by setup-env.mjs
# (32 random bytes, base64). Changing it makes stored secrets unreadable; re-enter them in Settings.
PRVISION_SECRET_KEY=

# Docker host ports, read only by docker compose (defaults shown). If you change one, change the
# matching DATABASE_URL / REDIS_URL above to the same port.
# PRVISION_PG_PORT=5433
# PRVISION_REDIS_PORT=6380

# Optional backend overrides (defaults shown).
# PORT=3100
# HOST=127.0.0.1
# FRONTEND_URL=http://localhost:4210
# PRVISION_DATA_DIR=~/.prvision
# LOG_LEVEL=info
# PRVISION_CLAUDE_COMMAND=claude   # Claude Code CLI used by the Claude Code provider
