{
  "name": "prvision-backend",
  "version": "0.1.0",
  "private": true,
  "description": "PRVision API and worker (Express 5, Drizzle, BullMQ, Playwright)",
  "main": "dist/app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/app.ts",
    "dev:worker": "ts-node-dev --respawn --transpile-only --exit-child src/worker.ts",
    "typecheck": "tsc --noEmit -p tsconfig.eslint.json",
    "lint": "cd .. && eslint -c backend/eslint.config.js --max-warnings 0 backend/src backend/scripts backend/drizzle.config.ts backend/eslint.config.js tests/backend",
    "lint:fix": "cd .. && eslint -c backend/eslint.config.js --max-warnings 0 backend/src backend/scripts backend/drizzle.config.ts backend/eslint.config.js tests/backend --fix",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --write \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,js}\" \"../tests/backend/**/*.ts\"",
    "format:check": "prettier --config .prettierrc.json --ignore-path .prettierignore --check \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,js}\" \"../tests/backend/**/*.ts\"",
    "check:architecture": "node scripts/check-architecture.mjs",
    "test": "node --test --test-reporter=spec --test-concurrency=1 --test-force-exit -r ts-node/register/transpile-only -r ../tests/backend/helpers/setup.ts \"../tests/backend/**/*.test.ts\"",
    "test:watch": "node --test --watch --test-concurrency=1 -r ts-node/register/transpile-only -r ../tests/backend/helpers/setup.ts \"../tests/backend/**/*.test.ts\"",
    "test:it": "PRVISION_IT_RENDER=${PRVISION_IT_RENDER:-1} node --test --test-reporter=spec --test-concurrency=1 --test-force-exit --test-timeout=900000 -r ts-node/register/transpile-only -r ../tests/backend/helpers/setup.ts \"../tests/backend/integration/**/*.test.ts\" \"../tests/backend/**/*.integration.test.ts\"",
    "validate:config": "ts-node --transpile-only scripts/validate-config.ts",
    "generate:models": "ts-node --transpile-only scripts/generate-models.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node --transpile-only scripts/drizzle-migrate.ts",
    "db:check": "ts-node --transpile-only scripts/check-db-connection.ts",
    "db:studio": "drizzle-kit studio",
    "drizzle:check": "drizzle-kit check",
    "drizzle:drift": "drizzle-kit generate && (git diff --exit-code --stat -- src/database/migrations && test -z \"$(git status --porcelain --untracked-files=all -- src/database/migrations)\" || (echo 'Drizzle schema drift: schema.ts changed without a committed migration. Run npm run db:generate and commit the result.' >&2 && exit 1))",
    "models:drift": "npm run generate:models && (git diff --exit-code --stat -- src/models && test -z \"$(git status --porcelain --untracked-files=all -- src/models)\" || (echo 'Model drift: src/models is out of sync with schema.ts. Run npm run generate:models and commit the result.' >&2 && exit 1))",
    "schema:sync": "npm run generate:models && npm run db:generate && npm run db:migrate",
    "playwright:install": "playwright install chromium",
    "datadir:init": "ts-node --transpile-only scripts/init-data-dir.ts",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run check:architecture && npm run test && npm run build",
    "postinstall": "node ../scripts/link-test-modules.mjs"
  },
  "dependencies": {
    "@angular/compiler": "~21.2",
    "@anthropic-ai/sdk": "^0.131.0",
    "@octokit/rest": "^22.0.1",
    "ajv": "^8.20.0",
    "bullmq": "^5.56.1",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "diff": "^8.0.2",
    "dotenv": "^17.2.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "pg": "^8.16.3",
    "pino": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0",
    "reflect-metadata": "0.2.2",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^9.39.5",
    "@types/cors": "2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "8.11.10",
    "@types/pngjs": "^6.0.5",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "2.0.0",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild": false,
    "msgpackr-extract": false,
    "unrs-resolver": false
  }
}
