{
  "name": "prvision-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/karma-chrome.mjs --watch=false",
    "test:watch": "node scripts/karma-chrome.mjs",
    "lint": "ng lint --max-warnings 0",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"*.{json,mjs}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"*.{json,mjs}\" \"scripts/**/*.mjs\"",
    "verify": "npm run format:check && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@angular/animations": "^19.2.20",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "@fontsource/manrope": "^5.3.0",
    "@tailwindcss/postcss": "^4.2.2",
    "ag-grid-angular": "^35.2.1",
    "ag-grid-community": "^35.2.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "material-icons": "^1.13.14",
    "material-symbols": "^0.47.6",
    "postcss": "^8.5.8",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.23",
    "@angular-eslint/builder": "^19.8.1",
    "@angular/cli": "^19.2.23",
    "@angular/compiler-cli": "^19.2.0",
    "@eslint/js": "^9.39.5",
    "@types/jasmine": "~5.1.0",
    "angular-eslint": "^19.8.1",
    "eslint": "^9.39.5",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
